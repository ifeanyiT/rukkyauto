{
  "name": "Rukky UGC Content Strategy Pipeline",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "weeks", "triggerAtDay": [1], "triggerAtHour": 8 }
          ]
        }
      },
      "id": "schedule",
      "name": "Weekly Trigger (Mon 8am)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300]
    },
    {
      "parameters": {
        "url": "https://rukky-ugc-scraper.onrender.com/scrape",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "source", "value": "demo" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "5Ol733lVMKSc5m8ael9GZZbyDY3sdjsyQDrtiL39tfo" }
          ]
        },
        "options": { "timeout": 120000 }
      },
      "id": "http",
      "name": "Get Trends (Scraper)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": { "fieldToSplitOut": "trends", "options": {} },
      "id": "split",
      "name": "Split Trends Into Items",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [480, 300]
    },
    {
      "parameters": { "batchSize": 5, "options": {} },
      "id": "loop",
      "name": "Loop In Batches Of 5",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [720, 300]
    },
    {
      "parameters": {
        "modelId": { "__rl": true, "value": "gpt-4o-mini", "mode": "list" },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are an expert UGC content strategist. For the given trending topic, respond ONLY with a JSON object of the form {\"hooks\": [\"hook1\", \"hook2\", \"hook3\"], \"strategy\": \"a 2-3 sentence campaign strategy\"}. Hooks must be short, scroll-stopping, first-person or POV style, ready to film."
            },
            {
              "role": "user",
              "content": "=Trending topic: {{ $json.topic }}\nExisting hook (if any): {{ $json.hook }}\nEngagement signal: {{ $json.engagement }}\nSource: {{ $json.source }}\n\nGenerate 3 high-converting UGC video hooks and a brief campaign strategy."
            }
          ]
        },
        "jsonOutput": true,
        "options": { "temperature": 0.8 }
      },
      "id": "openai",
      "name": "Generate Hooks (OpenAI)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [960, 300]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "f1", "name": "Topic", "type": "string", "value": "={{ $('Loop In Batches Of 5').item.json.topic }}" },
            { "id": "f2", "name": "Hooks", "type": "string", "value": "={{ ($json.message.content.hooks || []).join('\\n') }}" },
            { "id": "f3", "name": "Strategy", "type": "string", "value": "={{ $json.message.content.strategy }}" },
            { "id": "f4", "name": "Source Link", "type": "string", "value": "={{ $('Loop In Batches Of 5').item.json.source_link }}" },
            { "id": "f5", "name": "Performance Status", "type": "string", "value": "New" }
          ]
        },
        "options": {}
      },
      "id": "format",
      "name": "Format Row",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1180, 300]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "value": "1VqPxxloRO43Bf1rmrb_Lvp4GGpdQ-C1XbIYYe77HutU", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Rukky UGC Trends", "mode": "name" },
        "columns": {
          "mappingMode": "autoMapInputData",
          "matchingColumns": [],
          "value": {}
        },
        "options": {}
      },
      "id": "sheets",
      "name": "Save To Google Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1400, 300]
    }
  ],
  "connections": {
    "Weekly Trigger (Mon 8am)": { "main": [[{ "node": "Get Trends (Scraper)", "type": "main", "index": 0 }]] },
    "Get Trends (Scraper)": { "main": [[{ "node": "Split Trends Into Items", "type": "main", "index": 0 }]] },
    "Split Trends Into Items": { "main": [[{ "node": "Loop In Batches Of 5", "type": "main", "index": 0 }]] },
    "Loop In Batches Of 5": {
      "main": [
        [],
        [{ "node": "Generate Hooks (OpenAI)", "type": "main", "index": 0 }]
      ]
    },
    "Generate Hooks (OpenAI)": { "main": [[{ "node": "Format Row", "type": "main", "index": 0 }]] },
    "Format Row": { "main": [[{ "node": "Save To Google Sheet", "type": "main", "index": 0 }]] },
    "Save To Google Sheet": { "main": [[{ "node": "Loop In Batches Of 5", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
