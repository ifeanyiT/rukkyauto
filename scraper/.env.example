# Copy to .env for local runs. On Render, set these in the dashboard → Environment.

# Shared secret n8n must send in the "x-api-key" header. Make it long/random.
SCRAPER_API_KEY=change-me-to-a-long-random-string

# How many trends to collect before the pagination loop stops (spec: top 50).
TREND_THRESHOLD=50

# Path to Chrome/Chromedriver. Left blank = Selenium Manager auto-resolves (works in Docker).
CHROME_BINARY=
